// CopyMasterShell's resources: the CopyMaster icon (assets\CopyMaster.ico, made by dev\make-icons.cs)
// for the menu items, and a version block, so Explorer's crash reports and Task Manager can name us.

#include <winres.h>

#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_COPYMASTER ICON "..\\..\\assets\\CopyMaster.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Matthew Carven"
            VALUE "FileDescription", "CopyMaster Explorer extension"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "CopyMasterShell"
            VALUE "LegalCopyright", "MIT licence"
            VALUE "OriginalFilename", "CopyMasterShell.dll"
            VALUE "ProductName", "CopyMaster"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
